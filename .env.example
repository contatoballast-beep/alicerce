# 1. API & SERVER CONFIGURATION
PORT=4000
NODE_ENV=production
JWT_SECRET=sua_chave_secreta_jwt_super_segura_2026

# 2. DATABASE (Turso libSQL / Supabase PostgreSQL)
# Para banco local SQLite deixe vazio ou use: file:alicerce_local.db
# Para nuvem Turso use: libsql://alicerce-db-suaconta.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 3. SUPABASE (Opcional se utilizando PostgreSQL / Storage direto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. EMAIL TRANSACIONAL (Resend)
RESEND_API_KEY=

# 5. FRONTEND URL
VITE_API_URL=http://localhost:4000
