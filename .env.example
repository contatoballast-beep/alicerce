# ==============================================================================
# BALLAST ARCHITECTURE — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# 1. FRONTEND (Vercel)
# URL pública da API no Render/servidor (ex: https://api.ballastarch.com ou https://ballast-backend.onrender.com)
VITE_API_URL=http://localhost:4000

# 2. BACKEND (Render / Node)
PORT=4000
NODE_ENV=production
JWT_SECRET=substitua_por_uma_chave_secreta_forte_de_32_caracteres_ou_mais
CORS_ORIGINS=https://ballastarch.com,https://www.ballastarch.com

# 3. DATABASE (Turso libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 4. INTEGRATIONS (Opcional)
PIX_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
