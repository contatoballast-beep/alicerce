PORT=4000
NODE_ENV=development
# Obrigatório em produção (mínimo 32 caracteres aleatórios)
JWT_SECRET=substitua_por_uma_chave_secreta_forte_de_32_caracteres_ou_mais
# Origens permitidas separadas por vírgula
CORS_ORIGINS=https://ballastarch.com,https://www.ballastarch.com,http://localhost:3000,http://localhost:5173
# Banco Turso (vazio usa SQLite local para desenvolvimento)
TURSO_DATABASE_URL=file:ballast_local.db
TURSO_AUTH_TOKEN=
# Opcional: segredo do webhook autenticado de pagamento Pix
PIX_WEBHOOK_SECRET=
# Opcional: provisionamento único de conta admin (senha >= 12 caracteres)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
